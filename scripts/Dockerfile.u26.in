# Purpose: Creates the container for running the uEventAnalysisToolBackend
#          software in a Ubuntu container.
# Usage: podman build -t ueventanalysistoolbackend:latest -f Dockerfile.u26
#        buildah bud -t ueventanalysistoolbackend:latest -f Dockerfile.u26
#
# Written to run under a restricted Kubernetes securityContext:
# runAsNonRoot, readOnlyRootFilesystem, allowPrivilegeEscalation: false,
# and every capability dropped.  Nothing here needs any of them back.

# Unpacks the CPack tarball.  Its own stage, because a COPY is a layer:
# deleting the tarball in a later step would hide it but not remove it,
# and every image would carry the static library and headers forever.
# Only the binary leaves this stage.
FROM ubuntu:26.04 AS unpack
COPY @PROJECT_NAME@-@PROJECT_VERSION@-Linux.tar.gz /tmp/
RUN tar -xf /tmp/@PROJECT_NAME@-@PROJECT_VERSION@-Linux.tar.gz -C /tmp

FROM ubuntu:26.04

# Numeric, because Kubernetes cannot verify runAsNonRoot against a user
# name - it refuses to start the container rather than guess.  Override at
# build time if the cluster pins a different range.
ARG RUN_UID=10001
ARG RUN_GID=10001

LABEL version="@PROJECT_VERSION@"
# The binary links everything but the C and C++ runtimes statically, and
# those come with the base image.  ca-certificates is for TLS to the
# database and the telemetry collector.
#
# Setuid and setgid bits are stripped from everything in the image.  The
# process never needs to change identity, and allowPrivilegeEscalation:
# false already neuters them; this holds even where a pod spec forgets to
# set it.
RUN apt-get update &&\
    apt-get upgrade -y &&\
    apt-get -y install --no-install-recommends ca-certificates &&\
    groupadd --system --gid ${RUN_GID} ueat &&\
    useradd --system --uid ${RUN_UID} --gid ${RUN_GID} \
            --no-create-home --home-dir /nonexistent \
            --shell /usr/sbin/nologin ueat &&\
    apt-get autoremove -y &&\
    apt-get clean &&\
    rm -rf /var/lib/apt/lists/* &&\
    find / -xdev -type f -perm /6000 -exec chmod a-s {} +

# Owned by root and not writable by anyone, so the run user can execute
# the binary but not replace it.
COPY --from=unpack --chown=0:0 --chmod=0555 \
     /tmp/@PROJECT_NAME@-@PROJECT_VERSION@-Linux/bin/uEventAnalysisToolBackend \
     /usr/local/bin/uEventAnalysisToolBackend

# Run read-only (readOnlyRootFilesystem: true, no emptyDir): the process
# only reads its config and secrets and logs to stdout.  Nothing in the
# image is owned by the run user, so it could not write here anyway.
USER ${RUN_UID}:${RUN_GID}

# No EXPOSE: it binds nothing, and the port is decided by [GRPCServer] in
# the ini and the Service in the deployment.  N.B. that host must be
# 0.0.0.0, not the default localhost, for anything outside the pod to
# reach it.  Use a port above 1023 so no NET_BIND_SERVICE is needed.

# The process is PID 1, which gets no default signal handling: SIGTERM
# reaches the binary only because it installs its own handler, and it
# then shuts the server down.  It starts no children, so there is nothing
# for an init to reap.  Kubernetes sends SIGTERM; say so explicitly.
STOPSIGNAL SIGTERM

# CMD and no ENTRYPOINT, so a pod spec supplying command+args replaces this
# outright.  With an ENTRYPOINT, an args-only override would be appended to
# the binary instead of replacing it.
CMD ["/usr/local/bin/uEventAnalysisToolBackend", "--ini=/config/config.ini"]
